// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Event configuration (singleton row, id = 1)
// ─────────────────────────────────────────────
model EventSettings {
  id          Int      @id @default(1)
  title       String   @default("Aniversário")
  description String?  @db.Text
  eventDate   DateTime
  venueName   String?
  address     String
  mapsUrl     String?
  parking     String?
  dressCode   String?
  contact     String?
  pixKey      String?
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Guests & RSVP
// ─────────────────────────────────────────────
enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Guest {
  id             String      @id @default(cuid())
  name           String
  phone          String
  guestCount     Int         @default(1)
  message        String?     @db.Text
  status         GuestStatus @default(PENDING)
  invitationCode String?     @unique
  primaryGuestId String?
  viewedAt       DateTime?
  confirmedAt    DateTime?
  giftPurchases  GiftPurchase[]
  primaryGuest   Guest?      @relation("GuestCompanions", fields: [primaryGuestId], references: [id], onDelete: Cascade)
  companions     Guest[]     @relation("GuestCompanions")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([primaryGuestId, createdAt])
}

// ─────────────────────────────────────────────
// Gift registry
// ─────────────────────────────────────────────
enum GiftStatus {
  AVAILABLE
  RESERVED
}

enum GiftPurchaseStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

model Gift {
  id               String     @id @default(cuid())
  name             String
  description      String?    @db.Text
  imageUrl         String?
  purchaseUrl      String?
  price            Float?
  status           GiftStatus @default(AVAILABLE)
  reservedByName   String?
  reservedByPhone  String?
  reservedAt       DateTime?
  purchases        GiftPurchase[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model GiftPurchase {
  id                String             @id @default(cuid())
  giftId            String
  guestId           String
  buyerName         String
  buyerPhone        String
  invitationCode    String
  amount            Float?
  status            GiftPurchaseStatus @default(PENDING)
  provider          String?
  externalReference String?            @unique
  providerPaymentId String?            @unique
  paymentMethodId   String?
  paymentTypeId     String?
  statusDetail      String?
  qrCode            String?            @db.Text
  qrCodeBase64      String?            @db.Text
  paidAt            DateTime?
  lastWebhookAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  gift  Gift  @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([giftId, createdAt])
  @@index([guestId, createdAt])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────
// Gallery
// ─────────────────────────────────────────────
enum GalleryItemType {
  IMAGE
  VIDEO
}

model GalleryItem {
  id        String          @id @default(cuid())
  type      GalleryItemType @default(IMAGE)
  url       String
  caption   String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// ─────────────────────────────────────────────
// Admin user (NextAuth Credentials)
// ─────────────────────────────────────────────
model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
